#!/usr/bin/env guile
!#

(define source-directory (getenv "HOME"))
(define target-directory (cadr (command-line)))

(for-each (lambda (dir)
            (format #t "~%sending contents of ~a/~a into ~a/~a~%"
                    source-directory dir
                    target-directory dir)
            (system* "rsync" "-Phuav"
                     ;; "--dry-run"
                     ;; "--delete-after"
                     "--exclude=temp"
                     "--exclude=Trash"
                     "--exclude=guix-sandbox-home"
                     "--exclude=to-watch"
                     (format #f "~a/~a/" source-directory dir)
                     (format #f "~a/~a/" target-directory dir)))
          '("data"
            "documents"
            "downloads"
            ".gnupg"
            ".librewolf/native-messaging-hosts"
            ".local/share"
            "mail"
            "media"
            "src"
            ".ssh"
            "sync"))
