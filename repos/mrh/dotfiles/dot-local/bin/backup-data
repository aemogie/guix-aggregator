#!/usr/bin/env guile
!#

(define source-directory (getenv "HOME"))
(define target-directory "/mnt/backup-ssd")

(for-each (lambda (dir)
            (format #t "sending contents of ~a/~a into ~a/~a~%"
                    source-directory dir
                    target-directory dir)
            (system* "rsync" "-Phuav"
                     "--exclude=guix-sandbox-home"
                     "--exclude=movies"
                     "--exclude=shows"
                     "--exclude=jellyfin"
                     "--exclude=radarr"
                     "--exclude=sonarr"
                     "--exclude=Trash"
                     (format #f "~a/~a/" source-directory dir)
                     (format #f "~a/~a/" target-directory dir)))
          '("data"
            "documents"
            "downloads"
            ".gnupg"
            ".librewolf"
            ".local/share"
            "mail"
            "media"
            "src"
            ".ssh"
            "sync"))
