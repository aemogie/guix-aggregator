#!/bin/sh

LOCAL_PATH="$HOME/src/dotfiles/"

REMOTE_NAME=$1
REMOTE_PATH="~/src/dotfiles/"

rsync \
    --partial \
    --progress \
    --human-readable \
    --recursive \
    --update \
    --verbose \
    --exclude=jellyfin --exclude=sonarr --exclude=radarr \
    "$LOCAL_PATH" "$REMOTE_NAME:$REMOTE_PATH"
