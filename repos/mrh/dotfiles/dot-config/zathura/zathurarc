set adjust-open width
set selection-clipboard clipboard
set scroll-full-overlap 0.2
set zoom-step 10
set synctex true
set vertical-center true
set statusbar-home-tilde true
set window-title-basename true
set scroll-page-aware true

map n scroll down
map N scroll full-down
map p scroll up
map P scroll full-up
map b scroll left
mab B scroll full-left
map f scroll right
map F scroll full right

map <M-g> goto
map \< goto top
map \> goto bottom
map <C-p> navigate previous
map <C-n> navigate next

map = adjust_window width
map <A-1> adjust_window best-fit

map <C-f> follow
map <A-w> copy_link
map <C-s> search forward
map <C-r> search backward

map t recolor

map r rotate rotate_cw
map R rotate rotate_ccw

map <C-g> abort
