From e3a43ff0da21769de87cde90f4ba709bdccc1333 Mon Sep 17 00:00:00 2001
From: Hilton Chain <hako@ultrarare.space>
Date: Sat, 24 Jan 2026 23:33:04 +0800
Subject: [PATCH 4/5] modules/installer: Set up Nonguix channel in the final
 system.

---
 config/live/modules/gnu/installer/steps.scm | 27 +++++++++++++++++----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/config/live/modules/gnu/installer/steps.scm b/config/live/modules/gnu/installer/steps.scm
index b70e5eb..8c3039c 100644
--- a/config/live/modules/gnu/installer/steps.scm
+++ b/config/live/modules/gnu/installer/steps.scm
@@ -242,13 +242,30 @@ found in RESULTS."
 ;; Indicate which modules to import to access the variables
 ;; used in this configuration.\n"))
                    ,@(if (target-hurd?)
-                         '((use-modules (gnu) (gnu system hurd))
-                           (use-package-modules hurd ssh))
-                         '((use-modules (gnu))))
-                   (use-service-modules cups desktop networking ssh xorg))))
+                         '((use-modules (gnu)
+                                        (nonguix)
+                                        (gnu system hurd)
+                                        (gnu services cups)
+                                        (gnu services desktop)
+                                        (gnu services networking)
+                                        (gnu services ssh)
+                                        (gnu services xorg)
+                                        (gnu packages hurd)
+                                        (gnu packages ssh)))
+                         '((use-modules (gnu)
+                                        (nonguix)
+                                        (gnu services cups)
+                                        (gnu services desktop)
+                                        (gnu services networking)
+                                        (gnu services ssh)
+                                        (gnu services xorg)))))))
     `(,@modules
       ,(vertical-space 1)
-      (operating-system ,@configuration))))
+      (define %my-os
+        (operating-system ,@configuration))
+      ,(vertical-space 1)
+      ((compose (nonguix-transformation-guix))
+       %my-os))))
 
 (define* (configuration->file configuration
                               #:key (file-name (%installer-configuration-file)))
