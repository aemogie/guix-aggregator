From d7a20132b268d0edf3c43d2acaa21278c48b34f1 Mon Sep 17 00:00:00 2001
From: Hilton Chain <hako@ultrarare.space>
Date: Sat, 24 Jan 2026 23:33:21 +0800
Subject: [PATCH 5/5] modules/installer: Set Guile load paths to use modules
 from external channels. [WORKAROUND]

---
 config/live/modules/gnu/installer/final.scm | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/config/live/modules/gnu/installer/final.scm b/config/live/modules/gnu/installer/final.scm
index 22c44a2..e88d612 100644
--- a/config/live/modules/gnu/installer/final.scm
+++ b/config/live/modules/gnu/installer/final.scm
@@ -221,6 +221,8 @@ or #f.  Return #t on success and #f on failure."
              (setvbuf (current-error-port) 'none)
 
              (setenv "PATH" "/run/current-system/profile/bin/")
+             (setenv "GUILE_LOAD_PATH" "/run/current-system/profile/share/guile/site/3.0")
+             (setenv "GUILE_LOAD_COMPILED_PATH" "/run/current-system/profile/lib/guile/3.0/site-ccache")
 
              (for-each (lambda (line)
                          (installer-log-line "~a" line))
