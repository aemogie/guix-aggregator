{
	dns cloudflare {file./run/secrets/cloudflare}
	acme_dns cloudflare {file./run/secrets/cloudflare}
	ech hello.boiledscript.com
	log {
		output file /var/lib/caddy/access.log
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies_strict
	}
}


(block_bots) {
	import $$share/ai-robots-txt/Caddyfile$$
	handle @aibots {
		respond /* "Access denied" 403 {
			close
		}
	}
}

(guix_publish) {
	@guix_publish {
		path /*.narinfo || /file/* || /nar/* || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		reverse_proxy {args[0]}
	}
}

(logging) {
	log {
		output file /var/lib/caddy/{args[0]}.access.log
		format json
		format filter {
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
		}
	}
}

(pow) {
	@pow_matcher {
		header User-Agent *Mozilla*
	}
	proof_of_work @pow_matcher
}

(robots_txt) {
	respond /robots.txt 200 {
		body <<EOF
		User-Agent: *
		Disallow: /

		EOF
	}
}

(tailscale) {
	bind 100.97.195.93 [fd7a:115c:a1e0::2401:c35d]
}


files.boiledscript.com {
	import block_bots
	import pow
	import robots_txt

	import logging files
	root * /var/lib/webpublic/files
	file_server browse
}

ultrarare.space {
	import block_bots
	import logging blog

	root * /var/lib/webpublic/blog
	file_server

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
	handle_path /comments/* {
		reverse_proxy localhost:42174
	}
}

www.ultrarare.space {
	redir https://ultrarare.space{uri} permanent
}

# Cuirass
ci.boiledscript.com {
	import block_bots
	import pow
	import robots_txt

	import logging cuirass
	import guix_publish localhost:49637

	handle /admin/* {
		handle /admin/forgejo/event {
			import /run/secrets/cuirass/forgejo
		}
		handle {
			respond "Access denied" 403 {
				close
			}
		}
	}
	reverse_proxy localhost:17732
}

ci.ultrarare.space {
	import tailscale
	import logging cuirass
	import guix_publish localhost:49637
	reverse_proxy localhost:17732
}

