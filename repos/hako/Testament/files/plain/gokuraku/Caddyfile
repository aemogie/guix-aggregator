{
	dns cloudflare {file./run/secrets/cloudflare}
	acme_dns cloudflare {file./run/secrets/cloudflare}
	ech hello.boiledscript.com
	log {
		output file /var/log/caddy/caddy.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
	servers {
		metrics
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies_strict
	}
}


(robots_txt) {
	respond /robots.txt 200 {
		body <<EOF
		User-Agent: *
		Disallow: /

		EOF
	}
}

(logging) {
	log {
		output file /var/log/caddy/{args[0]}.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
}

(iocaine) {
	@read method GET HEAD
	@not-read not {
		method GET HEAD
	}
	reverse_proxy @read localhost:54504 {
		@fallback status 421
		handle_response @fallback {
			{block}
		}
	}
	handle @not-read {
		{block}
	}
}


files.boiledscript.com {
	import robots_txt
	import logging files

	root * /var/lib/webpublic/files
	import iocaine {
		file_server browse
	}
}

# Cuirass
ci.ultrarare.space {
	import logging cuirass

	import iocaine {
		@tailscale client_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
		handle @tailscale {
			reverse_proxy localhost:17732
		}
	}
}

ci.guix.moe {
	import robots_txt
	import logging cuirass

	import iocaine {
		@guix_publish {
			path /*.narinfo || /file/* || /nar/* || /nix-cache-info || /signing-key.pub
		}
		handle @guix_publish {
			reverse_proxy localhost:49637
		}
		handle /admin/* {
			handle /admin/forgejo/event {
				import /run/secrets/cuirass/forgejo
			}
			handle {
				respond "Access denied" 403 {
					close
				}
			}
		}
		reverse_proxy localhost:17732
	}
}

# Mirrors
cache-cdn.guix.moe {
	import robots_txt
	import logging substitutes

	@guix_publish {
		path /*.narinfo || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		root * /var/cache/guix/narinfo
		file_server
	}

	handle /nar/* {
		redir https://nars.guix.moe{uri}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}

cache-de.guix.moe {
	import robots_txt
	import logging substitutes

	@guix_publish {
		path /*.narinfo || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		root * /var/cache/guix/narinfo
		file_server
	}

	handle /nar/* {
		reverse_proxy https://nars.guix.moe {
			header_up Host {upstream_hostport}
		}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}

# Redirections
guix.moe, www.guix.moe {
	redir https://ultrarare.space/en/posts/guix-build-farm/
}
ci.boiledscript.com {
	redir https://ci.guix.moe{uri} permanent
}
cache-cdn.boiledscript.com, cache-de.boiledscript.com, cache-sg.boiledscript.com, cache-us-lax.boiledscript.com {
	redir https://cache-cdn.guix.moe{uri} permanent
}
