{
	email admin@boiledscript.com
	ech hello.boiledscript.com
	metrics
	log {
		output file /var/log/caddy/caddy.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies_strict
	}
}


(cloudflare) {
	tls {
		dns cloudflare {file./run/secrets/cloudflare}
	}
}

(logging) {
	log {
		output file /var/log/caddy/{args[0]}.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
}

(tailscale) {
	@tailscale client_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	handle @tailscale {
		{block}
	}
}


(block_bots) {
	import $$share/ai-robots-txt/Caddyfile$$
	handle @aibots {
		respond /robots.txt 200 {
			body <<EOF
			User-Agent: *
			Disallow: /

			EOF
		}
		respond /* "Access denied" 403 {
			close
		}
	}

	@fake {
		header User-Agent *Chrome/*
		header User-Agent *Firefox*
		header !Sec-Fetch-Mode
	}
	handle @fake {
		log_skip
		reverse_proxy localhost:54504
	}
}


files.boiledscript.com {
	import cloudflare
	import block_bots
	import logging files.boiledscript.com

	root * /var/lib/webpublic/files
	file_server browse
}

# Cuirass
ci.guix.moe {
	import cloudflare
	import block_bots
	import logging ci.guix.moe

	@guix_publish {
		path /*.narinfo || /file/* || /nar/* || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		reverse_proxy localhost:49637
	}
	handle /admin/* {
		handle /admin/forgejo/event {
			import /run/secrets/caddy/cuirass/forgejo
		}
		handle {
			import /run/secrets/caddy/cuirass/admin
		}
	}
	reverse_proxy localhost:17732
}

# Forgejo
git.ultrarare.space {
	import cloudflare
	import logging git.ultrarare.space
	import tailscale {
		reverse_proxy localhost:48071
	}
}

# Mirrors
cache-cdn.guix.moe {
	import cloudflare
	import block_bots
	import logging cache-cdn.guix.moe

	@guix_publish {
		path /*.narinfo || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		root * /var/cache/guix/narinfo
		file_server
	}

	handle /nar/* {
		redir https://nars.guix.moe{uri}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}

cache-de.guix.moe {
	import cloudflare
	import block_bots
	import logging cache-de.guix.moe

	@guix_publish {
		path /*.narinfo || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		root * /var/cache/guix/narinfo
		file_server
	}

	handle /nar/* {
		reverse_proxy https://nars.guix.moe {
			header_up Host {upstream_hostport}
		}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}


