reader.boiledscript.com {
	import robots_txt
	import logging miniflux

	reverse_proxy localhost:51787
}

# Misskey
social.boiledscript.com {
	import robots_txt
	import logging misskey

	reverse_proxy localhost:54493
}

# Vaultwarden
vault.boiledscript.com {
	import robots_txt
	import logging vaultwarden

	reverse_proxy localhost:23263
}

:80, :443, mail.boiledscript.com {
	import logging catchall
	respond /* "Access denied" 403 {
		close
	}
}
