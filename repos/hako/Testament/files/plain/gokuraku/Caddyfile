{
	email admin@boiledscript.com
	ech hello.boiledscript.com
	metrics
	log {
		output file /var/log/caddy/caddy.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies_strict
	}
}


(cloudflare) {
	tls {
		dns cloudflare {file./run/secrets/cloudflare}
	}
}

(logging) {
	log {
		output file /var/log/caddy/{args[0]}.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
}


(block_bots) {
	import $$share/ai-robots-txt/Caddyfile$$
	handle @aibots {
		respond /robots.txt 200 {
			body <<EOF
			User-Agent: *
			Disallow: /

			EOF
		}
		respond /* "Access denied" 403 {
			close
		}
	}
}

(iocaine) {
	@read method GET HEAD
	@not-read not {
		method GET HEAD
	}
	reverse_proxy @read localhost:54504 {
		@fallback status 421
		handle_response @fallback {
			{block}
		}
	}
	handle @not-read {
		{block}
	}
}


files.boiledscript.com {
	import cloudflare
	import block_bots
	import logging files.boiledscript.com

	import iocaine {
		root * /var/lib/webpublic/files
		file_server browse
	}
}

# Cuirass
ci.guix.moe {
	import cloudflare
	import block_bots
	import logging ci.guix.moe

	@guix_publish {
		path /*.narinfo || /file/* || /nar/* || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		reverse_proxy localhost:49637
	}
	handle /admin/* {
		handle /admin/forgejo/event {
			import /run/secrets/cuirass/forgejo
		}
		handle {
			import /run/secrets/cuirass/admin
		}
	}
	import iocaine {
		reverse_proxy localhost:17732
	}
}

# Mirrors
cache-cdn.guix.moe {
	import cloudflare
	import block_bots
	import logging cache-cdn.guix.moe

	@guix_publish {
		path /*.narinfo || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		root * /var/cache/guix/narinfo
		file_server
	}

	handle /nar/* {
		redir https://nars.guix.moe{uri}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}

cache-de.guix.moe {
	import cloudflare
	import block_bots
	import logging cache-de.guix.moe

	@guix_publish {
		path /*.narinfo || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		root * /var/cache/guix/narinfo
		file_server
	}

	handle /nar/* {
		reverse_proxy https://nars.guix.moe {
			header_up Host {upstream_hostport}
		}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}

# Redirections
guix.moe, www.guix.moe {
	import cloudflare
	redir https://ultrarare.space/en/posts/guix-build-farm/
}
ci.boiledscript.com {
	import cloudflare
	redir https://ci.guix.moe{uri} permanent
}
git.boiledscript.com {
	import cloudflare
	redir https://codeberg.org{uri}
}
cache-cdn.boiledscript.com, cache-de.boiledscript.com, cache-sg.boiledscript.com, cache-us-lax.boiledscript.com {
	import cloudflare
	redir https://cache-cdn.guix.moe{uri} permanent
}
