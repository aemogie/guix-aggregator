}

# Vaultwarden
vault.boiledscript.com {
	import block_bots
	import logging vault.boiledscript.com

	reverse_proxy localhost:23263
}

cache-fi.guix.moe {
	import block_bots
	import logging cache-fi.guix.moe

	@guix_publish {
		path /*.narinfo || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		root * /var/cache/guix-moe/narinfo
		file_server
	}

	handle /nar/* {
		reverse_proxy https://nars.guix.moe {
			header_up Host {upstream_hostport}
		}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}

mail.boiledscript.com {
	import block_bots
	import logging mail.boiledscript.com

	respond /* "Access denied" 403 {
		close
	}
}
