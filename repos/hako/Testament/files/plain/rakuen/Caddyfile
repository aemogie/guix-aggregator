{
	dns cloudflare {file./run/secrets/cloudflare}
	acme_dns cloudflare {file./run/secrets/cloudflare}
	ech hello.boiledscript.com
	metrics
	log {
		output file /var/log/caddy/caddy.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies_strict
	}
}


(logging) {
	log {
		output file /var/log/caddy/{args[0]}.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
}


(block_bots) {
	import $$share/ai-robots-txt/Caddyfile$$
	handle @aibots {
		respond /robots.txt 200 {
			body <<EOF
			User-Agent: *
			Disallow: /

			EOF
		}
		respond /* "Access denied" 403 {
			close
		}
	}

	@fake {
		header User-Agent *Chrome/*
		header User-Agent *Firefox*
		header !Sec-Fetch-Mode
	}
	handle @fake {
		log_skip
		reverse_proxy localhost:54504
	}
}


# Blog
ultrarare.space {
	import block_bots
	import logging ultrarare.space

	root * /var/lib/webpublic/blog
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
	handle_path /comments/* {
		reverse_proxy localhost:42174
	}
	file_server
}

www.ultrarare.space {
	redir https://ultrarare.space{uri} permanent
}

