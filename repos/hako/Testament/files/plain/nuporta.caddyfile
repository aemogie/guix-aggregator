{
	dns cloudflare {file./run/secrets/cloudflare}
	acme_dns cloudflare {file./run/secrets/cloudflare}
	ech hello.boiledscript.com
	metrics
	log {
		output file /var/log/caddy/caddy.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies_strict
	}
}


(logging) {
	log {
		output file /var/log/caddy/{args[0]}.log
		format filter {
			wrap json
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			fields {
				request>uri query {
					delete access_token
				}
			}
		}
	}
}

(block_bots) {
	import $$share/ai-robots-txt/Caddyfile$$
	handle @aibots {
		log_skip
		respond /* "Access denied" 403 {
			close
		}
	}

	@fake {
		header User-Agent *Chrome/*
		header User-Agent *Firefox*
		header !Sec-Fetch-Mode
	}
	handle @fake {
		log_skip
		respond /* "Access denied" 403 {
			close
		}
	}
}

(tailscale) {
	@tailscale client_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	handle @tailscale {
		{block}
	}
}


# URSpace

# Blog
ultrarare.space {
	root * /var/lib/webpublic/ultrarare.space
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
	file_server
}

# Forgejo
git.urspace.moe {
	import tailscale {
		reverse_proxy localhost:48071
	}
}

# Grafana
dash.urspace.moe {
	import tailscale {
		reverse_proxy localhost:13064
	}
}

# Loki
logs.urspace.moe {
	import block_bots
	import /run/secrets/caddy/loki
	reverse_proxy localhost:50968
}

# Mimir
metrics.urspace.moe {
	import block_bots
	import /run/secrets/caddy/mimir
	reverse_proxy localhost:49951
}

# Miniflux
reader.urspace.moe {
	import block_bots
	reverse_proxy localhost:51787
}

# Misskey
boiledscript.com {
	import block_bots
	reverse_proxy localhost:54493
}

# Vaultwarden
vault.urspace.moe {
	import block_bots
	reverse_proxy localhost:23263
}

files.boiledscript.com {
	import block_bots
	root * /var/lib/webpublic/files
	file_server browse
}


# Guix Moe

# Cuirass
ci.guix.moe {
	import block_bots

	@guix_publish {
		path /*.narinfo || /file/* || /nar/* || /nix-cache-info || /signing-key.pub
	}
	handle @guix_publish {
		reverse_proxy localhost:49637
	}

	@forgejo_hooks {
		path /admin/forgejo/event || /jobset/*/hook/evaluate
	}
	handle @forgejo_hooks {
		import /run/secrets/caddy/cuirass/forgejo
	}

	handle /admin/* {
		import /run/secrets/caddy/cuirass/admin
	}

	reverse_proxy localhost:17732
}

# Mirrors
cache-cdn.guix.moe {
	import block_bots
	import logging cache-cdn.guix.moe

	handle /*.narinfo {
		root * /var/cache/guix-moe/narinfo
		file_server
	}

	handle /nar/* {
		redir https://nars.guix.moe{uri}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}

cache-fi.guix.moe, cache-de.guix.moe {
	import block_bots
	import logging cache-fi.guix.moe

	handle /*.narinfo {
		root * /var/cache/guix-moe/narinfo
		file_server
	}

	handle /nar/* {
		reverse_proxy https://nars.guix.moe {
			header_up Host {upstream_hostport}
		}
	}

	respond "Visit guix [dot] moe for more information." 404 {
		close
	}
}


:80, :443, mail.boiledscript.com {
	respond /* "Access denied" 403 {
		close
	}
}
