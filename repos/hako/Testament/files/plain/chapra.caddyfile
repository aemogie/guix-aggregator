{
	dns cloudflare {file./run/secrets/cloudflare}
	acme_dns cloudflare {file./run/secrets/cloudflare}
	ech hello.boiledscript.com
	metrics
	log {
		output file /var/log/caddy/caddy.log
		format filter {
			request>remote_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			request>client_ip ip_mask {
				ipv4 20
				ipv6 44
			}
			wrap json
		}
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies_strict
	}
}


# Komga
manga.ultrarare.space {
	reverse_proxy localhost:44293
}

# Navidrome
music.ultrarare.space {
	reverse_proxy localhost:43502
}

# Jellyfin
shows.ultrarare.space {
	reverse_proxy localhost:22443
}
