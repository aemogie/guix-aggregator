---
 modules/installer/gnu/installer/newt/welcome.scm | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/modules/installer/gnu/installer/newt/welcome.scm b/modules/installer/gnu/installer/newt/welcome.scm
index f821374..fddcc93 100644
--- a/modules/installer/gnu/installer/newt/welcome.scm
+++ b/modules/installer/gnu/installer/newt/welcome.scm
@@ -184,12 +184,10 @@ Documentation is accessible at any time by pressing Ctrl-Alt-F2.")
    #:listbox-items
    `((,(G_ "Graphical install using a terminal based interface")
       .
-      ,(lambda ()
-         (check-hardware-support pci-database)))
+      ,(const #t))
      (,(G_ "Install using the shell based process")
       .
       ,(lambda ()
-         (check-hardware-support pci-database)
          ;; Switch to TTY3, where a root shell is available for shell based
          ;; install. The other root TTY's would have been ok too.
          (system* "chvt" "3")
