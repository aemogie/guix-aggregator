sort=-time
layer=overlay
background-color=#2e3440
width=500
height=110
border-size=2
border-color=#88c0d0
border-radius=10
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=monospace 12

[urgency=low]
border-color=#cccccc

[urgency=normal]
border-color=#d08770

[urgency=high]
border-color=#bf616a
default-timeout=0

[category=mail]
group-by=category
on-notify=exec mpv ~/.guix-home/profile/share/sounds/freedesktop/stereo/message.oga

[category=irc]
group-by=category
on-notify=exec mpv ~/.guix-home/profile/share/sounds/freedesktop/stereo/complete.oga
