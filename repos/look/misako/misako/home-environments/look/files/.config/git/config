[color]
ui = true

[core]
editor = hx
hookspath = ~/.config/git/hooks

[commit]
gpgsign = false

[user]
signingkey = 8B37296FCE5C491047373BAA3BF514F584DC25AD

[init]
defaultBranch = main

[alias]
see = log --graph --all --oneline
last = log -1 HEAD

[remote "upstream"]
fetch = +refs/pull/*/head:refs/remotes/upstream/pr/*

[sendemail]
smtpserver = {{{ aerc.primary.url }}}
smtpuser = {{{ aerc.primary.email }}}
smtpencryption = ssl
smtpserverport = 465
annotate = true

[safe]
directory = ~/projects/guile/guix
