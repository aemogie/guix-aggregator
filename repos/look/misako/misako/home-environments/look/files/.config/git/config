[color]
ui = true

[core]
editor = hx

[commit]
gpgsign = false

[user]
signingkey = 3FFA7335973E0A4947FC0A8C38D596BE07D334AB

[init]
defaultBranch = main

[alias]
see = log --graph --all --oneline
last = log -1 HEAD

[remote "origin"]
fetch = +refs/pull/*/head:refs/remotes/origin/pr/*

[remote "upstream"]
fetch = +refs/pull/*/head:refs/remotes/upstream/pr/*

[sendemail]
smtpserver = {{{ aerc.primary.url }}}
smtpuser = {{{ aerc.primary.email }}}
smtpencryption = ssl
smtpserverport = 465
annotate = true

[safe]
directory = ~/projects/guile/guix
