set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot 
set $screenshot grim
set $menu fuzzel

output * scale 1 mode 2880x1800@60Hz bg $HOME/.wp.png fill
exec swayidle -w \
         timeout 300 'swaylock -f --image "/home/lynn/.wp.png"' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f --image "/home/lynn/.wp.png"' \

for_window [title="emacs-capture-*"] floating enable, move position center

input type:keyboard {
      #xkb_options ctrl:swapcaps,compose:lctrl
      xkb_options ctrl:nocaps,compose:grave
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

    bindsym $mod+space+t exec swaymsg input type:touchpad events toggle enabled disabled
    bindsym $mod+Return exec $term
    bindsym $mod+Shift+c kill
    bindsym $mod+p exec $menu
    floating_modifier $mod normal
    bindsym $mod+Shift+q reload
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+b splith
    bindsym $mod+v splitv
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split
    bindsym $mod+f fullscreen
    bindsym Print exec $screenshot
    bindsym $mod+Shift+s exec grim -g "$(slurp)"
    bindsym $mod+s exec sh -c 'tmp=$(mktemp /tmp/ocr.XXXXXX.png) && grim -g "$(slurp)" "$tmp" && TESSDATA_PREFIX=$(guix build tesseract-ocr-tessdata-fast)/share/tessdata tesseract -l chi_sim "$tmp" stdout | wl-copy && rm "$tmp"'
    bindsym $mod+o exec emacsclient -c -n -e '(switch-to-buffer nil)'
    bindsym $mod+n exec emacsclient -c -n -e '(switch-to-buffer nil)' -e '(org-capture)'
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space focus mode_toggle
    bindsym $mod+a focus parent
    
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

font Iosevka Term Slab 18px
gaps inner 10
default_border pixel 0
default_floating_border normal
blur on
corner_radius 10
shadows enable
shadow_blur_radius 20
default_dim_inactive 0.05

layer_effects "waybar" {
    blur enable;
    blur_ignore_transparent enable;
}

bar {
  swaybar_command waybar
}

Exec pipewire
exec emacs --fg-daemon
exec light -U 90
exec dbus-update-activation-environment --all
exec fcitx5
