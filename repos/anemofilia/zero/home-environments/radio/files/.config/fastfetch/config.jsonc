{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/media/pictures/feel/sleep-atkinson.jpg"
    },
    "display": {
        "size": {
            "maxPrefix": "MB",
            "ndigits": 0
        },
        "color": {
            "keys": "#d7c0ff",
        },
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        "packages",
        "shell",
        "editor",
        "wm",
        "terminal",
        {
            "type": "terminalfont",
            "format": "{/name}{-}{/}{name}{?size} {size}{?}"
        },
        "cpu",
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{vendor}(R) {name} {frequency}"
        },
        {
            "type": "memory",
            "format": "{} / {}"
        },
        {
            "type": "bios",
            "key": "Bios",
            "format": "{vendor} {release} ({date})"
        },
    ]
}
