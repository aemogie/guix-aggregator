#!/bin/sh

region="$(slurp 2>/dev/null)" || region="0,0 1366x768"

save_to_file=$(echo -en 'y\nn' \
               | fuzzel --dmenu \
                        --lines=0 \
                        --auto-select \
                        --prompt="Save image to disk? (y/n) ")

if  [ $? -ne 0 ]; then
    notify-send "Screenshot aborted" -t 1000
    exit
fi

if [ $save_to_file = "y" ]; then
    filename="$XDG_PICTURES_DIR/screenshots/$(date +%Y-%m-%d--%H-%M-%S.png)"
    grim -g "$region" "$filename"
    notify-send "Screenshot saved as $filename" -t 1000
else
    grim -g "$region" -t png - | wl-copy -t image/png
    notify-send "Screenshot saved to clipboard" -t 1000
fi
