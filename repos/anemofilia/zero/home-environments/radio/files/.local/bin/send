#!/bin/sh

[ "$1" = "-c" ] && shift 1 && realpath -s "$@" | wl-copy

lswt | grep -q 'org.telegram' \
|| setsid -f Telegram >/dev/null 2>&1 \
&& sleep 3

river-bedload -print tags | jq -e 'map(select(.id == 8)).[].focused' >/dev/null \
|| wlrctl keyboard type '.' modifiers SUPER

lswt -j | jq -e '.toplevels | map(select(."app-id" == "org.telegram.desktop")).[].activated' >/dev/null \
|| wlrctl toplevel focus org.telegram

realpath -z "$@" | xargs -0 Telegram -sendpath
